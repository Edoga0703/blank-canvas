# Supabase propio de Capiversa
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Almacenamiento de multimedia en Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=capiversa-media
# Opcional: dominio publico del bucket. Para comprobantes y audios es preferible
# dejarlo vacio y entregar enlaces firmados de corta duracion desde el servidor.
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_BYTES=52428800
R2_SIGNED_URL_TTL_SECONDS=900

# La beta usa una empresa y el conector oficial de WhatsApp de Lovable.
VITE_BETA_LOVABLE_WHATSAPP_ONLY=true
LOVABLE_WHATSAPP_MAX_WEBHOOK_BYTES=1048576
