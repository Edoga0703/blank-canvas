# Supabase propio de Capiversa
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Almacenamiento de multimedia en Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=capiversa-media
# Opcional: dominio publico del bucket. Para comprobantes y audios es preferible
# dejarlo vacio y entregar enlaces firmados de corta duracion desde el servidor.
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_BYTES=52428800
R2_SIGNED_URL_TTL_SECONDS=900

# La beta usa una empresa y el conector oficial de WhatsApp de Lovable.
VITE_BETA_LOVABLE_WHATSAPP_ONLY=true
LOVABLE_WHATSAPP_MAX_WEBHOOK_BYTES=1048576

# Instagram Direct y Facebook Messenger mediante las API oficiales de Meta.
# Este flag es independiente del proveedor de WhatsApp de la beta.
VITE_META_CHANNELS_ENABLED=true
PUBLIC_APP_URL=
# Origenes adicionales separados por coma. Deben usar https, salvo localhost.
META_ALLOWED_ORIGINS=
META_APP_ID=
META_APP_SECRET=
# Solo es necesario cuando Instagram usa un App de Meta diferente.
META_APP_SECRET_INSTAGRAM=
META_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_ALLOW_UNSIGNED_WEBHOOKS=false

# Tareas programadas internas (/api/public/hooks/*)
CRON_SECRET=

# D-API WhatsApp SaaS
DAPI_API_KEY=
DAPI_BASE_URL=https://api.d-api.cloud/api/v1

# Webhooks D-API: use este secreto global o webhook_token por instancia.
DAPI_WEBHOOK_SECRET=

# Clave aleatoria larga para firmar enlaces temporales de medios.
MEDIA_SIGNING_SECRET=

