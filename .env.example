# ==============================================================================
# Capiconversa CRM — Variables de Entorno de Referencia
# ==============================================================================

# URL pública principal del CRM (usada para callbacks OAuth, webhooks y links)
PUBLIC_APP_URL=https://capiconversa.com
VITE_PUBLIC_APP_URL=https://capiconversa.com
APP_URL=
PUBLIC_BASE_URL=

# Supabase principal (runtime SSR y cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_SERVICE_ROLE_KEY=

# Supabase externo / self-hosted (override cuando el Worker apunta a VPS propia)
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_ANON_KEY=
EXTERNAL_SERVICE_ROLE_KEY=
VITE_EXTERNAL_SUPABASE_URL=
VITE_EXTERNAL_SUPABASE_ANON_KEY=

# Almacenamiento multimedia en Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=capiversa-media
# Opcional: dominio público del bucket. Para comprobantes y audios es preferible
# dejarlo vacío y entregar enlaces firmados de corta duración desde el servidor.
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_BYTES=52428800
R2_SIGNED_URL_TTL_SECONDS=900

# Secretos internos, firmas y cifrado
APP_SECRET=
APP_USER_CONNECTION_KEY_SECRET=
MEDIA_SIGNING_SECRET=
LEAD_PHOTO_SECRET=

# Tareas programadas internas (/api/public/hooks/*)
CRON_SECRET=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Proveedores de Inteligencia Artificial
GLOBAL_AI_PROVIDER=
GLOBAL_AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ADMIN_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOVABLE_API_KEY=
DRAEL_API_KEY=
DRAEL_BASE_URL=

# D-API WhatsApp SaaS (QR Code y Cloud API)
DAPI_API_KEY=
DAPI_BASE_URL=https://api.d-api.cloud/api/v1
DAPI_WEBHOOK_SECRET=
VITE_DAPI_PUBLISHABLE_KEY=
VITE_BETA_LOVABLE_WHATSAPP_ONLY=false

# Canales Meta (Instagram Direct y Facebook Messenger)
VITE_META_CHANNELS_ENABLED=true
# Orígenes adicionales separados por coma (https, salvo localhost)
META_ALLOWED_ORIGINS=
META_APP_ID=
META_APP_SECRET=
# Solo necesario cuando Instagram usa un App de Meta diferente
META_APP_SECRET_INSTAGRAM=
META_WEBHOOK_VERIFY_TOKEN=

# Telegram MTProto Gateway Sidecar
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_SECRET=
GATEWAY_SECRET=
ALLOW_TELEGRAM_SIMULATION=false

# Webhooks y pasarelas de pago
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_TOKEN=
CAKTO_WEBHOOK_TOKEN=
KIWIFY_WEBHOOK_TOKEN=
PERFECTPAY_WEBHOOK_TOKEN=

# Google OAuth, Calendar, Drive, Sheets, Ads y Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_DRIVE_APP_USER_CONNECTOR_CLIENT_API_KEY=
GOOGLE_SHEETS_APP_USER_CONNECTOR_CLIENT_API_KEY=

# TikTok Content API (opcional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Límites globales de plataforma (opcional)
PLATFORM_MAX_COMPANIES=
PLATFORM_MAX_CONTATOS=
PLATFORM_MAX_DB_BYTES=
PLATFORM_MAX_INSTANCES=
PLATFORM_MAX_MESSAGES_30D=
PLATFORM_MAX_USERS=

# ==============================================================================
# Variables heredadas sin uso activo (# deprecated)
# ==============================================================================
# deprecated: reemplazada por configuración centralizada en Supabase externo
VITE_SUPABASE_PROJECT_ID=
# deprecated: el conector WhatsApp de prueba ya no limita payloads con esta variable
LOVABLE_WHATSAPP_MAX_WEBHOOK_BYTES=1048576
# deprecated: los webhooks de Meta exigen firma HMAC válida en producción
META_ALLOW_UNSIGNED_WEBHOOKS=false
# deprecated: flujo de login Meta usa configuración directa de App
META_LOGIN_CONFIG_ID=
